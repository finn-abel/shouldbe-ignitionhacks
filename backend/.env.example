# Backend environment — copy to .env and fill in. NEVER commit the real .env.

# Persistence (step 1). SQLite locally; Render Postgres URL in the cloud. A `postgres://`
# or `postgresql://` URL is rewritten to the psycopg2 driver on load, so paste Render's
# Internal Database URL exactly as given.
DATABASE_URL=sqlite:///./shouldbe.db

# CORS: the origin the React dev server / deployed static site is served from.
FRONTEND_ORIGIN=http://localhost:5173

# The calendar the money is reported in. "This month" and the chart's days are answered
# here, not in UTC — otherwise an evening meeting lands on tomorrow and the budget
# headline rolls over on the last night of the month.
SHOULDBE_TIMEZONE=America/Toronto

# The most meeting time one occurrence is charged for. A calendar is not only meetings:
# an all-day .ics event reads as 1440 minutes and a week-long conference as 6240.
SHOULDBE_MAX_BILLABLE_MINUTES=480

# Populate an EMPTY database with the curated guest ledger on boot. Meant for a fresh
# deploy, where the alternative is demoing an empty dashboard. It never overwrites a
# ledger that already has meetings — `python -m app.seed` is the deliberate reset.
SHOULDBE_SEED_ON_START=0

# LLM stub seam (doc 2 §8). 1 = offline heuristic stub, 0 = real provider.
SHOULDBE_USE_STUB=1

# Signs the session cookie (step 11). There is no default: unset, a deployed app refuses
# to boot and a local one signs with a random per-process key (so a restart logs you out).
# A shared constant here would mean anyone reading the repo could forge any user's session.
# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(32))"
SESSION_SECRET=

# Session cookie attributes. `lax`/false is correct locally, where the frontend and the
# API are both localhost and count as the same site. DEPLOYED THEY DO NOT: set
# SESSION_COOKIE_SAMESITE=none and SESSION_COOKIE_SECURE=true, or the browser drops the
# cookie on every cross-site API call and the whole app answers 401.
SESSION_COOKIE_SAMESITE=lax
SESSION_COOKIE_SECURE=false

# SESSION_COOKIE_SECURE is also how the app infers whether it is deployed, since it is
# required in the cloud and meaningless on localhost. That inference gates the settings
# that must not fail open: SESSION_SECRET and POSTMARK_WEBHOOK_SECRET become mandatory,
# HSTS is sent, and /docs is closed. Override it directly if your host looks different.
# SHOULDBE_ENV=production
# Re-open the interactive API docs on a deployed host. Off by default.
# SHOULDBE_PUBLIC_DOCS=0

# Where the OAuth callback sends the browser back to.
FRONTEND_URL=http://localhost:5173

# Real scoring (step 12). Leave empty and keep SHOULDBE_USE_STUB=1 to run offline.
LLM_PROVIDER=openai
OPENAI_MODEL=gpt-5-nano
OPENAI_API_KEY=
# Output budget for one scoring call. On a reasoning model this covers the model's own
# reasoning as well as the answer, and the reasoning is spent FIRST — at 1200 gpt-5-nano
# used 1152 tokens thinking and returned an empty response, so every analysis fell back to
# a neutral keep verdict. Measured usage at this setting is ~950 (≈700 reasoning, ≈250
# answer); you are billed for tokens used, not for the cap.
LLM_MAX_TOKENS=4000

# Optional generic fallback, if you want one env var for either provider.
LLM_API_KEY=

# Optional alternate provider. Use LLM_PROVIDER=anthropic to enable it.
ANTHROPIC_MODEL=claude-opus-5
ANTHROPIC_API_KEY=

# --- Google sign-in (step 11) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Door A: inbound invites (Postmark) ---
# Postmark RECEIVES invites: an MX on the invite subdomain points at
# inbound.postmarkapp.com, and Postmark POSTs the parsed .ics to /webhook/inbound-email.
# It does not send anything — see the outbound block below.
POSTMARK_TOKEN=
# The base address people invite. Each user gets it plus-addressed with their routing
# token (ledger+ab12cd@...) so the invite lands on their ledger, not the guest's.
# Excluded from attendee costs, tag and all, so ShouldBe is never billed as a guest.
SHOULDBE_INBOX=
# Shared secret for the public webhook. Add it to the Postmark webhook URL as ?token=...
# The endpoint is public and it sends email, so an unprotected one is a spam relay — and
# it writes to whichever ledger the invite resolves to. Optional locally; deployed, an
# unset secret means the webhook answers 503 rather than accepting anonymous invites.
POSTMARK_WEBHOOK_SECRET=

# --- Outbound replies (Resend) ---
# 'resend' or 'postmark'. Leave unset to infer: Resend when RESEND_API_KEY is present,
# otherwise Postmark. Resend is the default because it reaches any recipient as soon as
# the domain is verified in DNS, whereas a new Postmark account waits on a manual human
# review that can outlast the thing you are trying to demo.
EMAIL_PROVIDER=
RESEND_API_KEY=
# Must be an address on the domain verified at resend.com/domains.
RESEND_FROM=

# Only used when EMAIL_PROVIDER=postmark, which is the fallback path.
POSTMARK_FROM=
POSTMARK_STREAM=outbound

# How often queued replies are retried, in seconds. 0 disables the background drain.
# A reply is a committed row before it is ever sent, so a provider outage delays delivery
# instead of losing it — the drain keeps trying until it lands.
OUTBOX_DRAIN_SECONDS=120
