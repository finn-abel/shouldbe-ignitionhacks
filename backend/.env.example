# Backend environment — copy to .env and fill in. NEVER commit the real .env.

# Persistence (step 1). SQLite locally; Render Postgres URL in the cloud.
DATABASE_URL=sqlite:///./shouldbe.db

# CORS: the origin the React dev server / deployed static site is served from.
FRONTEND_ORIGIN=http://localhost:5173

# LLM stub seam (doc 2 §8). 1 = offline heuristic stub, 0/unset = real provider.
SHOULDBE_USE_STUB=1

# Signs the session cookie (step 11). Change it for anything deployed.
SESSION_SECRET=dev-only-not-a-real-secret

# Where the OAuth callback sends the browser back to.
FRONTEND_URL=http://localhost:5173

# Real scoring (step 12). Leave empty and keep SHOULDBE_USE_STUB=1 to run offline.
LLM_API_KEY=

# --- Google sign-in (step 11) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Door A: inbound invites and outbound replies (step 13) ---
POSTMARK_TOKEN=
POSTMARK_FROM=
POSTMARK_STREAM=outbound
# The address people invite. Excluded from attendee costs so ShouldBe is never billed.
SHOULDBE_INBOX=
# Shared secret for the public webhook. Add it to the Postmark webhook URL as ?token=...
POSTMARK_WEBHOOK_SECRET=
