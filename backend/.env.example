# Backend environment — copy to .env and fill in. NEVER commit the real .env.

# Persistence (step 1). SQLite locally; Render Postgres URL in the cloud.
DATABASE_URL=sqlite:///./shouldbe.db

# CORS: the origin the React dev server / deployed static site is served from.
FRONTEND_ORIGIN=http://localhost:5173

# LLM stub seam (doc 2 §8). 1 = offline heuristic stub, 0/unset = real provider.
SHOULDBE_USE_STUB=1

# --- placeholders, unused until their step ---
LLM_API_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
POSTMARK_TOKEN=
